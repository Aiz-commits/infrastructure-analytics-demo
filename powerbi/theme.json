{
  "name": "Infrastructure Analytics Dark",
  "dataColors": ["#338ced", "#e76624", "#00a888", "#d28e05", "#e24d8b", "#0aac23", "#9887ef", "#eb6263"],
  "background": "#191919",
  "foreground": "#efefef",
  "tableAccent": "#338ced",
  "good": "#0aac23",
  "neutral": "#fbb315",
  "bad": "#dc3c3d",
  "minimum": "#1757ac",
  "center": "#519ced",
  "maximum": "#cce3fd",
  "textClasses": {
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#efefef" },
    "title": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#efefef" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#efefef" },
    "label": { "fontSize": 10, "fontFace": "Segoe UI", "color": "#9c9c9c" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#111111" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#111111" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#191919" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#2a2a2a" } }, "radius": 4 }],
        "title": [{ "fontColor": { "solid": { "color": "#efefef" } } }]
      }
    }
  }
}
